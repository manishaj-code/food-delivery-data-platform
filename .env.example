# -----------------------------------------------------------------------------
# food-delivery-data-platform — environment configuration template
#
# Copy to `.env` (git-ignored) and adjust. NEVER commit real secrets.
# Values below are placeholders / local-development defaults only.
# See docs/spec/11-security-specification.md §4 for every variable.
# -----------------------------------------------------------------------------

# General
PIPELINE_ENV=local
LOG_LEVEL=INFO

# Storage: local | s3
STORAGE_MODE=local
LOCAL_LAKE_PATH=/opt/project/lake
SOURCE_DATA_PATH=/opt/project/data/generated

# AWS (only used when STORAGE_MODE=s3 / WAREHOUSE_TYPE=redshift / METRICS_ENABLED=true)
# After `terraform apply`, `terraform output -raw env_file` prints the AWS-mode values
# (STORAGE_MODE, WAREHOUSE_TYPE, S3_BUCKET, REDSHIFT_HOST/PORT/DATABASE,
# REDSHIFT_SECRET_ARN, REDSHIFT_IAM_ROLE_ARN, REDSHIFT_COPY_AUTH) to paste here.
AWS_REGION=ap-south-1
# Local named profile; credentials live in ~/.aws, never here. Containers see ~/.aws only
# with the read-only override: docker compose -f docker-compose.yml -f docker-compose.aws.yml …
# AWS_PROFILE=food-delivery-sandbox
S3_BUCKET=

# Warehouse: postgres (local) | redshift (AWS)
# In local mode the REDSHIFT_* variables point to the local PostgreSQL warehouse.
WAREHOUSE_TYPE=postgres
REDSHIFT_HOST=postgres
REDSHIFT_PORT=5432
REDSHIFT_DATABASE=warehouse
REDSHIFT_SCHEMA=food_delivery
REDSHIFT_USER=warehouse_user
# Local mode: also initialises the Compose postgres service on its first start
# (changing it later requires `docker compose down -v` to recreate the database volume).
REDSHIFT_PASSWORD=change-me-local-only
# Host port for SQL clients (DBeaver, psql) to reach the local warehouse
# POSTGRES_HOST_PORT=5433
# AWS mode: leave REDSHIFT_PASSWORD empty and use Secrets Manager instead
REDSHIFT_SECRET_ARN=
REDSHIFT_IAM_ROLE_ARN=
# iam_role | session (sandbox fallback when role creation is blocked)
REDSHIFT_COPY_AUTH=iam_role

# Data quality
DQ_MIN_QUALITY_SCORE=95.0

# Spark (8 GB host: keep at 1g)
SPARK_DRIVER_MEMORY=1g

# Monitoring: false = METRIC log lines only; true = CloudWatch custom metrics
# (namespace FoodDelivery/Pipeline, dimension Environment = PIPELINE_ENV, which must be the
# Terraform environment, e.g. dev, for the failure alarm to match). Metric errors never fail a run.
METRICS_ENABLED=false

# Airflow (local Compose only). Generate your own values; never commit them.
# Same uid as the pipeline container's app user (both write lake/ and data/)
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
# Airflow metadata database (created by airflow-init). URL-safe characters only:
# it becomes part of a connection URL.
AIRFLOW_DB_PASSWORD=change-me-local-only
# Required, e.g.: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-local-only
AIRFLOW_API_SECRET_KEY=change-me-local-only
# Host port of the Airflow UI (http://localhost:8080)
# AIRFLOW_HOST_PORT=8080
